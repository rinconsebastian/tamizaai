# Claude Code
.claude/

# Environment and local development state (credentials, keys). Every .env* file is ignored, including
# the ones named .envprod or .envstaging, so a provider key is not committed by accident; only the
# documented example is kept. This does not untrack a file git already tracks.
.env*
!.env.example
.local/

# .NET
bin/
obj/
*.user
TestResults/

# Node / Angular
node_modules/
dist/
.angular/
coverage/

# Python
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/

# Editors and OS
.vs/
.idea/
.DS_Store

