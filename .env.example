# Tamiza for KoboToolbox: deployment settings.
# Copy this file to .env and fill in every REQUIRED value before `docker compose up -d`.
# Compose refuses to start and names the variable when a required value is missing.

# --- Public access -------------------------------------------------------------------------------

# REQUIRED. Public base URL of this installation, as browsers and Kobo reach it.
# Use HTTPS for anything other than localhost: sign-in needs a secure context.
# Example: https://tamiza.example.org
TAMIZA_PUBLIC_URL=

# Optional. Host port for the ui service, the only published port. Default: 8088 (8080 is left
# free for a local Keycloak). Prefix an address to bind one interface only, e.g. 127.0.0.1:8088
# behind a local HTTPS proxy.
TAMIZA_HTTP_PORT=8088

# Optional. Name of the Docker network the reverse proxy is attached to. Used only with
# compose.proxy.yaml (docker compose -f compose.yaml -f compose.proxy.yaml up -d), which also joins
# ui to that network; the network must already exist. Default: bridgemysql
PROXY_NETWORK=bridgemysql

# --- Authentication (external Keycloak; see docs/keycloak.md) -------------------------------------

# REQUIRED. Realm URL as the browser sees it; also the expected token issuer.
# Example: https://auth.example.org/realms/tamiza
OIDC_AUTHORITY=

# REQUIRED. Public client the UI signs in with. Example: tamiza-ui
OIDC_CLIENT_ID=

# REQUIRED. Audience the API requires in access tokens (added by a Keycloak audience mapper).
# Example: tamiza-api
OIDC_AUDIENCE=

# Optional. Discovery document URL reachable from inside the stack, when it differs from
# OIDC_AUTHORITY (for example, Keycloak on the same host). Default: derived from OIDC_AUTHORITY.
# Example: http://keycloak.internal:8080/realms/tamiza/.well-known/openid-configuration
OIDC_METADATA_ADDRESS=

# Optional. Scopes the UI requests. Default: openid profile email
OIDC_SCOPE=openid profile email

# Optional. Require HTTPS for the discovery document. Set to false only for a development realm
# served over plain HTTP. Default: true
OIDC_REQUIRE_HTTPS_METADATA=true

# Optional. Comma-separated emails with the global superadmin role. Granted only when Keycloak
# marks the email as verified. Changes apply after restarting the api service. Default: empty.
# A superadmin acts as admin on every project and can create projects even when none exists.
# Other users can create projects only if they are admin of at least one project, so leave
# this empty and nobody can create the first project of a new installation. Set it to your own
# email before you first sign in.
TAMIZA_SUPERADMIN_EMAILS=

# --- Kobo ----------------------------------------------------------------------------------------

# Optional. Allow Kobo servers on private networks (10.x, 192.168.x, localhost...) and over plain
# HTTP, for a self-hosted Kobo on the same network. Keep false unless you need it: it lets users
# point the API at internal addresses. See docs/kobo.md. Default: false
TAMIZA_KOBO_ALLOW_PRIVATE_NETWORKS=false

# --- Database ------------------------------------------------------------------------------------

# REQUIRED. Password for the database role. Generate one with: openssl rand -hex 24
# Avoid ';' and quotes. It is read when the database volume is first created; changing it
# afterwards also requires ALTER ROLE inside the database (see docs/operations.md).
POSTGRES_PASSWORD=

# Optional. Database role used by api and analytics. Default: tamiza
POSTGRES_USER=tamiza

# --- Runtime -------------------------------------------------------------------------------------

# Optional. Tag for the tamiza-ui, tamiza-api and tamiza-analytics images. Default: dev
TAMIZA_VERSION=dev

# Optional. Minimum log level for the api service (Trace, Debug, Information, Warning, Error).
# Default: Information
TAMIZA_LOG_LEVEL=Information

# Optional. Seconds between analytics worker cycles. Default: 5
TAMIZA_WORKER_POLL_SECONDS=5

# --- Python scripts ------------------------------------------------------------------------------
# Limits for each analyst script in a pipeline run. A script that exceeds one is stopped and its
# step fails. Keep TAMIZA_RUN_MEMORY_MB a few hundred MB below ANALYTICS_MEMORY_LIMIT: the worker
# itself needs room next to the script. See docs/operations.md.

# Optional. Seconds a script may run. Default: 600
TAMIZA_RUN_TIMEOUT_SECONDS=600

# Optional. Memory a script may use, in MB. Default: 1024
TAMIZA_RUN_MEMORY_MB=1024

# Optional. Seconds a run waits to publish its tables while a dashboard export is still reading the
# previous ones, before the step fails and the previous tables stay published. Default: 900
TAMIZA_PUBLISH_WAIT_SECONDS=900

# Optional. Disk, in MB, that script tests may use to keep the flattened sample and the result of
# script 1 for the next test, so repeated tests and "Run cell" skip those steps. 0 turns reuse off.
# Default: 512
TAMIZA_TEST_CACHE_MB=512

# Optional. The largest "Download sample" zip, in MB. A sample that would be larger fails with a
# message and nothing is kept. Prepared downloads are kept in the database for an hour, so this bounds
# the space they use: at most one per analyst and project. Default: 100
TAMIZA_SAMPLE_DOWNLOAD_MB=100

# --- AI assistant (optional) ---------------------------------------------------------------------
# An assistant in the Scripts section that drafts, rewrites and fixes scripts. It is on only when
# BASE_URL, MODEL and API_KEY are all set; otherwise nothing is shown and nothing leaves the server.
# Requests go from the api container to the provider you choose, in the OpenAI chat-completions
# format: the schema, the choice lists, the script and the errors of the last test are sent, never
# rows of data. Choosing a provider is a data-protection decision: read its terms first. Changes
# apply after restarting the api service. Example settings for several providers, what is sent and
# how to check a provider are in docs/operations.md. Never commit a file that holds the key.

# Base URL of the provider's OpenAI-compatible API, such as https://api.example.org/v1. A server on
# the local network or the Docker host (http://host.docker.internal:11434/v1) works too.
TAMIZA_ASSISTANT_BASE_URL=

# Model name, as the provider calls it.
TAMIZA_ASSISTANT_MODEL=

# Key sent as "Authorization: Bearer". A self-hosted server without keys still needs any value here.
TAMIZA_ASSISTANT_API_KEY=

# Optional. A JSON object merged into every request, for fields a provider needs or to lower its
# reasoning effort. It may not set model, messages or stream. Put it in single quotes, e.g.
# TAMIZA_ASSISTANT_EXTRA_BODY='{"reasoning_effort":"low"}'. Default: empty
TAMIZA_ASSISTANT_EXTRA_BODY=

# Optional. Seconds to wait for the provider's answer, 10 to 240. Behind your own reverse proxy keep
# its read timeout above this. Default: 120
TAMIZA_ASSISTANT_TIMEOUT_SECONDS=120

# Optional. Tokens each user may use per UTC day, 1000 to 100000000. Default: 500000
TAMIZA_ASSISTANT_DAILY_TOKENS_PER_USER=500000

# Optional. The most context sent in one request, in KB, 64 to 1024. A self-hosted model's context
# window must hold this plus the answer. Default: 128
TAMIZA_ASSISTANT_MAX_CONTEXT_KB=128

# --- Map basemaps (optional) ---------------------------------------------------------------------
# A background map, streets or satellite imagery, under the dashboard's maps. It is off unless a
# provider is set; with none, no browser and no server makes a request to any tile provider. A
# deployment offers one provider only. Changes apply after restarting the api service
# (docker compose up -d api). The terms of each provider, the cost controls and what leaves the
# deployment are in docs/operations.md. Never commit a file that holds the key.

# Optional. none, osm or google. Default: empty (none)
#   osm:    OpenStreetMap streets, loaded by each viewer's browser from tile.openstreetmap.org. Its
#           tile policy forbids heavy or commercial use; each viewer's IP address and the tile
#           coordinates they look at reach OpenStreetMap.
#   google: Google streets and satellite, through the Map Tiles API. Only the api container
#           contacts Google (tile.googleapis.com); the key never reaches a browser. Needs
#           TAMIZA_MAP_GOOGLE_API_KEY and billing on your Google Cloud project.
# With a provider set, any project member can turn a basemap on for any map on their own screen.
# Tamiza sends no indicator value, row or geometry to a provider, only tile coordinates (and, for
# Google, the zoom and bounds of the area on screen).
TAMIZA_MAP_BASEMAP_PROVIDER=

# Required with google. A Map Tiles API key. Restrict it in the Google Cloud console to the Map Tiles
# API and to the api container's outbound IP address, and set a daily quota and billing alerts there.
TAMIZA_MAP_GOOGLE_API_KEY=

# Optional, google only. An IETF language tag for Google's labels, such as es-419. Default: empty (en-US)
TAMIZA_MAP_GOOGLE_LANGUAGE=

# Optional, google only. A region code for Google's labels and borders, such as CO. Default: empty (US)
TAMIZA_MAP_GOOGLE_REGION=

# Optional, google only. Tiles each user may be sent per minute, 60 to 10000. Default: 600
TAMIZA_MAP_TILES_PER_MINUTE=600

# Optional, google only. Tiles each user may be sent per UTC day, 100 to 1000000. Keep it well under
# your Google daily quota divided by your users (Google's default is 15,000 2D tiles a day). Default: 3000
TAMIZA_MAP_TILES_PER_USER_PER_DAY=3000

# --- Account emails (optional, Keycloak only) ----------------------------------------------------
# Lets project admins send invitation emails (creating the account when the person has none), send
# them again, and send a member a password reset email. Tamiza asks Keycloak, through its admin API,
# and Keycloak sends the emails with the realm's SMTP settings. It is on only when CLIENT_ID and
# CLIENT_SECRET are both set; otherwise nothing changes and admins tell people themselves. The
# client needs the realm-management roles manage-users and view-users, and the realm should be
# dedicated to Tamiza. With another OpenID Connect provider leave these empty: sign-in still works.
# Setup steps are in docs/keycloak.md. Never commit a file that holds the secret. Changes apply after
# restarting the api service.

# ID of a confidential Keycloak client with a service account, such as tamiza-admin.
TAMIZA_KEYCLOAK_ADMIN_CLIENT_ID=

# Secret of that client, from its Credentials tab.
TAMIZA_KEYCLOAK_ADMIN_CLIENT_SECRET=

# Optional. Base URL the api uses for Keycloak's token and admin endpoints, such as
# http://keycloak:8080, when the public address (OIDC_AUTHORITY) does not serve /admin or the api
# container cannot reach it. Default: derived from OIDC_METADATA_ADDRESS or OIDC_AUTHORITY.
TAMIZA_KEYCLOAK_ADMIN_URL=

# Optional. Hours the links in these emails stay valid, 1 to 720. Default: empty, which keeps the
# realm's own setting (12 hours in a default Keycloak realm).
TAMIZA_KEYCLOAK_LINK_HOURS=

# Optional. Account emails one user may cause per hour (invitations, resends and password resets
# together), 1 to 1000. The same person is never sent two within 10 minutes. Default: 20
TAMIZA_ACCOUNT_EMAILS_PER_HOUR=20

# --- Email (optional) ----------------------------------------------------------------------------
# Lets analysts and admins give a dashboard a scheduled email: its figures in the body and its
# tables in an XLSX attachment, sent on chosen weekdays to up to 20 addresses that need not be
# Tamiza users. Tamiza sends it itself, from the api container, through the SMTP server set here
# (Keycloak's account emails above do not use it). It is on only when HOST and FROM are both set;
# otherwise nothing is shown and no SMTP connection is opened. With only one of them, email stays
# off and the api logs one warning. An invalid value stops the api at startup and names the
# variable. The email carries project data out of the deployment: choosing a provider, SPF and
# DKIM, Microsoft 365, checking with Mailpit and what is sent are in docs/operations.md. Changes
# apply after restarting the api service (docker compose up -d api). Never commit a file that
# holds the password.

# Host name of the SMTP server, such as smtp.example.org. The api container must reach it.
TAMIZA_SMTP_HOST=

# Optional. Port of the SMTP server, 1 to 65535.
# Default: 587 with starttls, 465 with tls, 25 with none
TAMIZA_SMTP_PORT=

# Optional. starttls, tls or none. Default: empty (starttls)
#   starttls: connects, then upgrades with STARTTLS before signing in. A server that does not offer
#             STARTTLS fails the send; nothing is sent unencrypted.
#   tls:      TLS from the start (implicit TLS, usually port 465).
#   none:     no encryption. Only for a relay inside your own network or a test server such as
#             Mailpit.
# With starttls and tls the server's certificate is always validated.
TAMIZA_SMTP_SECURITY=

# Optional. User name for the SMTP server. Set it together with the password, or leave both empty
# to send without signing in (a relay that trusts the api's address); with only one of them the
# api does not start. Default: empty
TAMIZA_SMTP_USERNAME=

# Optional. Password for that user name. Never logged nor shown. Spaces at either end are removed,
# like a pasted trailing newline. Default: empty
TAMIZA_SMTP_PASSWORD=

# Sender address, a plain email address such as reports@example.org (no display name). It is never
# a recipient, so it needs no mailbox and a no-reply address works, but the SMTP server must accept
# it as a sender and its domain must pass SPF and DKIM (see docs/operations.md).
TAMIZA_SMTP_FROM=

# Optional. Display name of the sender. Default: Tamiza
TAMIZA_SMTP_FROM_NAME=

# Optional. Seconds to wait for the SMTP server before a send fails as "server unavailable",
# 5 to 300. Default: 30
TAMIZA_SMTP_TIMEOUT_SECONDS=

# --- Memory limits -------------------------------------------------------------------------------
# Optional. Per-service limits; the defaults add up to 3200m, which fits a 4 GB VPS.

# Default: 1024m
DB_MEMORY_LIMIT=1024m
# Default: 512m
API_MEMORY_LIMIT=512m
# Default: 1536m
ANALYTICS_MEMORY_LIMIT=1536m
# Default: 128m
UI_MEMORY_LIMIT=128m
